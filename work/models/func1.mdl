Potencial ZX2
 Constraints
  Name         |> Expression                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <|
%*slhaFound    |1+access("vars1.lha", 0)                                                                                       %Check whether LHA file is present.
%*rdSLHA       |if(slhaFound,slhaRead("vars1.lha", 0),-1)                                                                      %Read LHA file.
%cabi          |if(slhaFound,if(slhaValExists("CKMBLOCK",1,1),slhaVal("CKMBLOCK",0,1,1),cabiDef),cabiDef)                      %Cabibbo angle                                     
%aEWM1         |if(slhaFound,if(slhaValExists("SMINPUTS",1,1),slhaVal("SMINPUTS",0,1,1),aEWM1Def),aEWM1Def)                    %Inverse of the EW coupling constant at the Z pole 
%Gf            |if(slhaFound,if(slhaValExists("SMINPUTS",1,2),slhaVal("SMINPUTS",0,1,2),GfDef),GfDef)                          %Fermi constant                                    
%aS            |if(slhaFound,if(slhaValExists("SMINPUTS",1,3),slhaVal("SMINPUTS",0,1,3),aSDef),aSDef)                          %Strong coupling constant at the Z pole            
%ymdo          |if(slhaFound,if(slhaValExists("YUKAWA",1,1),slhaVal("YUKAWA",0,1,1),ymdoDef),ymdoDef)                          %Down Yukawa mass                                  
%ymup          |if(slhaFound,if(slhaValExists("YUKAWA",1,2),slhaVal("YUKAWA",0,1,2),ymupDef),ymupDef)                          %Up Yukawa mass                                    
%yms           |if(slhaFound,if(slhaValExists("YUKAWA",1,3),slhaVal("YUKAWA",0,1,3),ymsDef),ymsDef)                            %Strange Yukawa mass                               
%ymc           |if(slhaFound,if(slhaValExists("YUKAWA",1,4),slhaVal("YUKAWA",0,1,4),ymcDef),ymcDef)                            %Charm Yukawa mass                                 
%ymb           |if(slhaFound,if(slhaValExists("YUKAWA",1,5),slhaVal("YUKAWA",0,1,5),ymbDef),ymbDef)                            %Bottom Yukawa mass                                
%ymt           |if(slhaFound,if(slhaValExists("YUKAWA",1,6),slhaVal("YUKAWA",0,1,6),ymtDef),ymtDef)                            %Top Yukawa mass                                   
%yme           |if(slhaFound,if(slhaValExists("YUKAWA",1,11),slhaVal("YUKAWA",0,1,11),ymeDef),ymeDef)                          %Electron Yukawa mass                              
%ymm           |if(slhaFound,if(slhaValExists("YUKAWA",1,13),slhaVal("YUKAWA",0,1,13),ymmDef),ymmDef)                          %Muon Yukawa mass                                  
%ymtau         |if(slhaFound,if(slhaValExists("YUKAWA",1,15),slhaVal("YUKAWA",0,1,15),ymtauDef),ymtauDef)                      %Tau Yukawa mass                                   
%lP            |if(slhaFound,if(slhaValExists("FRBlock",1,1),slhaVal("FRBlock",0,1,1),lPDef),lPDef)                            %Acoplamiento Phi                                  
%lL1           |if(slhaFound,if(slhaValExists("FRBlock",1,2),slhaVal("FRBlock",0,1,2),lL1Def),lL1Def)                          %Acoplamiento left                                 
%lR1           |if(slhaFound,if(slhaValExists("FRBlock",1,3),slhaVal("FRBlock",0,1,3),lR1Def),lR1Def)                          %Acoplamiento right                                
%gLR           |if(slhaFound,if(slhaValExists("FRBlock",1,4),slhaVal("FRBlock",0,1,4),gLRDef),gLRDef)                          %Acoplamiento lr                                   
%gLL           |if(slhaFound,if(slhaValExists("FRBlock",1,5),slhaVal("FRBlock",0,1,5),gLLDef),gLLDef)                          %Acoplamiento ll                                   
%gRR           |if(slhaFound,if(slhaValExists("FRBlock",1,6),slhaVal("FRBlock",0,1,6),gRRDef),gRRDef)                          %Acoplamiento rr                                   
%gLP           |if(slhaFound,if(slhaValExists("FRBlock",1,7),slhaVal("FRBlock",0,1,7),gLPDef),gLPDef)                          %Acoplamiento lp                                   
%gRP           |if(slhaFound,if(slhaValExists("FRBlock",1,8),slhaVal("FRBlock",0,1,8),gRPDef),gRPDef)                          %Acoplamiento rp                                   
%K1            |if(slhaFound,if(slhaValExists("FRBlock",1,9),slhaVal("FRBlock",0,1,9),K1Def),K1Def)                            %Acoplamiento hlr                                  
%K2            |if(slhaFound,if(slhaValExists("FRBlock",1,10),slhaVal("FRBlock",0,1,10),K2Def),K2Def)                          %Acoplamiento hrr                                  
%K3            |if(slhaFound,if(slhaValExists("FRBlock",1,11),slhaVal("FRBlock",0,1,11),K3Def),K3Def)                          %Acoplamiento hll                                  
%K4            |if(slhaFound,if(slhaValExists("FRBlock",1,12),slhaVal("FRBlock",0,1,12),K4Def),K4Def)                          %Acoplamiento hhl                                  
%K5            |if(slhaFound,if(slhaValExists("FRBlock",1,13),slhaVal("FRBlock",0,1,13),K5Def),K5Def)                          %Acoplamiento hhr                                  
%K6            |if(slhaFound,if(slhaValExists("FRBlock",1,14),slhaVal("FRBlock",0,1,14),K6Def),K6Def)                          %Acoplamiento hhp                                  
%K7            |if(slhaFound,if(slhaValExists("FRBlock",1,15),slhaVal("FRBlock",0,1,15),K7Def),K7Def)                          %Acoplamiento hlp                                  
%K8            |if(slhaFound,if(slhaValExists("FRBlock",1,16),slhaVal("FRBlock",0,1,16),K8Def),K8Def)                          %Acoplamiento hrp                                  
%MZ            |if(slhaFound,if(slhaValExists("MASS",1,23),slhaVal("MASS",0,1,23),MZDef),MZDef)                                %Mass of G0.                                       
%Me            |if(slhaFound,if(slhaValExists("MASS",1,11),slhaVal("MASS",0,1,11),MeDef),MeDef)                                %Mass of e.                                        
%MMU           |if(slhaFound,if(slhaValExists("MASS",1,13),slhaVal("MASS",0,1,13),MMUDef),MMUDef)                              %Mass of mu.                                       
%MTA           |if(slhaFound,if(slhaValExists("MASS",1,15),slhaVal("MASS",0,1,15),MTADef),MTADef)                              %Mass of ta.                                       
%MU            |if(slhaFound,if(slhaValExists("MASS",1,2),slhaVal("MASS",0,1,2),MUDef),MUDef)                                  %Mass of u.                                        
%MC            |if(slhaFound,if(slhaValExists("MASS",1,4),slhaVal("MASS",0,1,4),MCDef),MCDef)                                  %Mass of c.                                        
%MT            |if(slhaFound,if(slhaValExists("MASS",1,6),slhaVal("MASS",0,1,6),MTDef),MTDef)                                  %Mass of t.                                        
%MD            |if(slhaFound,if(slhaValExists("MASS",1,1),slhaVal("MASS",0,1,1),MDDef),MDDef)                                  %Mass of d.                                        
%MS            |if(slhaFound,if(slhaValExists("MASS",1,3),slhaVal("MASS",0,1,3),MSDef),MSDef)                                  %Mass of s.                                        
%MB            |if(slhaFound,if(slhaValExists("MASS",1,5),slhaVal("MASS",0,1,5),MBDef),MBDef)                                  %Mass of b.                                        
%MH            |if(slhaFound,if(slhaValExists("MASS",1,25),slhaVal("MASS",0,1,25),MHDef),MHDef)                                %Mass of H.                                        
%mX11          |if(slhaFound,if(slhaValExists("MASS",1,10137),slhaVal("MASS",0,1,10137),mX11Def),mX11Def)                      %Mass of X11.                                      
%mX12          |if(slhaFound,if(slhaValExists("MASS",1,10012),slhaVal("MASS",0,1,10012),mX12Def),mX12Def)                      %Mass of X12.                                      
%mX13          |if(slhaFound,if(slhaValExists("MASS",1,10013),slhaVal("MASS",0,1,10013),mX13Def),mX13Def)                      %Mass of X13.                                      
%mX21          |if(slhaFound,if(slhaValExists("MASS",1,10021),slhaVal("MASS",0,1,10021),mX21Def),mX21Def)                      %Mass of X21.                                      
%mX22          |if(slhaFound,if(slhaValExists("MASS",1,10022),slhaVal("MASS",0,1,10022),mX22Def),mX22Def)                      %Mass of X22.                                      
%mX23          |if(slhaFound,if(slhaValExists("MASS",1,10023),slhaVal("MASS",0,1,10023),mX23Def),mX23Def)                      %Mass of X23.                                      
%mX31          |if(slhaFound,if(slhaValExists("MASS",1,10031),slhaVal("MASS",0,1,10031),mX31Def),mX31Def)                      %Mass of X31.                                      
%mX32          |if(slhaFound,if(slhaValExists("MASS",1,10032),slhaVal("MASS",0,1,10032),mX32Def),mX32Def)                      %Mass of X32.                                      
%mX33          |if(slhaFound,if(slhaValExists("MASS",1,10033),slhaVal("MASS",0,1,10033),mX33Def),mX33Def)                      %Mass of X33.                                      
%mZL11         |if(slhaFound,if(slhaValExists("MASS",1,10000),slhaVal("MASS",0,1,10000),mZL11Def),mZL11Def)                    %Mass of ZL11.                                     
%mZL12         |if(slhaFound,if(slhaValExists("MASS",1,10001),slhaVal("MASS",0,1,10001),mZL12Def),mZL12Def)                    %Mass of ZL12.                                     
%mZL13         |if(slhaFound,if(slhaValExists("MASS",1,10002),slhaVal("MASS",0,1,10002),mZL13Def),mZL13Def)                    %Mass of ZL13.                                     
%mZL21         |if(slhaFound,if(slhaValExists("MASS",1,10003),slhaVal("MASS",0,1,10003),mZL21Def),mZL21Def)                    %Mass of ZL21.                                     
%mZL22         |if(slhaFound,if(slhaValExists("MASS",1,10004),slhaVal("MASS",0,1,10004),mZL22Def),mZL22Def)                    %Mass of ZL22.                                     
%mZL23         |if(slhaFound,if(slhaValExists("MASS",1,10005),slhaVal("MASS",0,1,10005),mZL23Def),mZL23Def)                    %Mass of ZL23.                                     
%mZL31         |if(slhaFound,if(slhaValExists("MASS",1,10006),slhaVal("MASS",0,1,10006),mZL31Def),mZL31Def)                    %Mass of ZL31.                                     
%mZL32         |if(slhaFound,if(slhaValExists("MASS",1,10007),slhaVal("MASS",0,1,10007),mZL32Def),mZL32Def)                    %Mass of ZL32.                                     
%mZL33         |if(slhaFound,if(slhaValExists("MASS",1,10008),slhaVal("MASS",0,1,10008),mZL33Def),mZL33Def)                    %Mass of ZL33.                                     
%mZR11         |if(slhaFound,if(slhaValExists("MASS",1,10009),slhaVal("MASS",0,1,10009),mZR11Def),mZR11Def)                    %Mass of ZR11.                                     
%mZR12         |if(slhaFound,if(slhaValExists("MASS",1,10010),slhaVal("MASS",0,1,10010),mZR12Def),mZR12Def)                    %Mass of ZR12.                                     
%mZR13         |if(slhaFound,if(slhaValExists("MASS",1,10011),slhaVal("MASS",0,1,10011),mZR13Def),mZR13Def)                    %Mass of ZR13.                                     
%mZR21         |if(slhaFound,if(slhaValExists("MASS",1,10012),slhaVal("MASS",0,1,10012),mZR21Def),mZR21Def)                    %Mass of ZR21.                                     
%mZR22         |if(slhaFound,if(slhaValExists("MASS",1,10013),slhaVal("MASS",0,1,10013),mZR22Def),mZR22Def)                    %Mass of ZR22.                                     
%mZR23         |if(slhaFound,if(slhaValExists("MASS",1,10014),slhaVal("MASS",0,1,10014),mZR23Def),mZR23Def)                    %Mass of ZR23.                                     
%mZR31         |if(slhaFound,if(slhaValExists("MASS",1,10015),slhaVal("MASS",0,1,10015),mZR31Def),mZR31Def)                    %Mass of ZR31.                                     
%mZR32         |if(slhaFound,if(slhaValExists("MASS",1,10016),slhaVal("MASS",0,1,10016),mZR32Def),mZR32Def)                    %Mass of ZR32.                                     
%mZR33         |if(slhaFound,if(slhaValExists("MASS",1,10017),slhaVal("MASS",0,1,10017),mZR33Def),mZR33Def)                    %Mass of ZR33.                                     
%WZ            |if(slhaFound,if(1+slhaDecayExists(23),slhaWidth(23),WZDef),WZDef)                                              %Width of G0.                                      
%WW            |if(slhaFound,if(1+slhaDecayExists(24),slhaWidth(24),WWDef),WWDef)                                              %Width of GP.                                      
%WT            |if(slhaFound,if(1+slhaDecayExists(6),slhaWidth(6),WTDef),WTDef)                                                %Width of t.                                       
%WH            |if(slhaFound,if(1+slhaDecayExists(25),slhaWidth(25),WHDef),WHDef)                                              %Width of H.                                       
aEW            |pow(aEWM1,-1)                                                                                                  % Electroweak coupling contant                      
MW             |pow(pow(MZ,2)/2.+pow(-(aEW*Pi*pow(2,-0.5)*pow(Gf,-1)*pow(MZ,2))+pow(MZ,4)/4.,0.5),0.5)                         % W mass                                            
sw2            |1-pow(MW,2)*pow(MZ,-2)                                                                                         % Squared Sin of the Weinberg angle                 
EE             |2*pow(aEW,0.5)*pow(Pi,0.5)                                                                                     % Electric coupling constant                        
cw             |pow(1-sw2,0.5)                                                                                                 % Cosine of the Weinberg angle                      
sw             |pow(sw2,0.5)                                                                                                   % Sine of the Weinberg angle                        
gw             |EE*pow(sw,-1)                                                                                                  % Weak coupling constant at the Z pole              
g1             |EE*pow(cw,-1)                                                                                                  % U(1)Y coupling constant at the Z pole             
vev            |2*MW*sw*pow(EE,-1)                                                                                             % Higgs vacuum expectation value                    
lam            |(pow(MH,2)*pow(vev,-2))/2.                                                                                     % Higgs quartic coupling                            
muH            |pow(lam*pow(vev,2),0.5)                                                                                        % Coefficient of the quadratic piece of the Higgs po
ye             |yme*pow(2,0.5)*pow(vev,-1)                                                                                     % Lepton Yukawa couplings ( ye )                    
ym             |ymm*pow(2,0.5)*pow(vev,-1)                                                                                     % Lepton Yukawa couplings ( ym )                    
ytau           |ymtau*pow(2,0.5)*pow(vev,-1)                                                                                   % Lepton Yukawa couplings ( ytau )                  
yup            |ymup*pow(2,0.5)*pow(vev,-1)                                                                                    % Up-type Yukawa couplings ( yup )                  
yc             |ymc*pow(2,0.5)*pow(vev,-1)                                                                                     % Up-type Yukawa couplings ( yc )                   
yt             |ymt*pow(2,0.5)*pow(vev,-1)                                                                                     % Up-type Yukawa couplings ( yt )                   
ydo            |ymdo*pow(2,0.5)*pow(vev,-1)                                                                                    % Down-type Yukawa couplings ( ydo )                
ys             |yms*pow(2,0.5)*pow(vev,-1)                                                                                     % Down-type Yukawa couplings ( ys )                 
yb             |ymb*pow(2,0.5)*pow(vev,-1)                                                                                     % Down-type Yukawa couplings ( yb )                 
CKM1x1         |cos(cabi)                                                                                                      % CKM-Matrix ( CKM1x1 )                             
CKM1x2         |sin(cabi)                                                                                                      % CKM-Matrix ( CKM1x2 )                             
CKM1x3         |0                                                                                                              % CKM-Matrix ( CKM1x3 )                             
CKM2x1         |-sin(cabi)                                                                                                     % CKM-Matrix ( CKM2x1 )                             
CKM2x2         |cos(cabi)                                                                                                      % CKM-Matrix ( CKM2x2 )                             
CKM2x3         |0                                                                                                              % CKM-Matrix ( CKM2x3 )                             
CKM3x1         |0                                                                                                              % CKM-Matrix ( CKM3x1 )                             
CKM3x2         |0                                                                                                              % CKM-Matrix ( CKM3x2 )                             
CKM3x3         |1                                                                                                              % CKM-Matrix ( CKM3x3 )                             
I1a11          |CKM1x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I1a12          |CKM2x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I1a13          |CKM3x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I1a21          |CKM1x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1a22          |CKM2x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1a23          |CKM3x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1a31          |CKM1x3*yb                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1a32          |CKM2x3*yb                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1a33          |CKM3x3*yb                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2a11          |CKM1x1*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I2a12          |CKM2x1*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2a13          |CKM3x1*yt                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2a21          |CKM1x2*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I2a22          |CKM2x2*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2a23          |CKM3x2*yt                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2a31          |CKM1x3*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I2a32          |CKM2x3*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2a33          |CKM3x3*yt                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3a11          |CKM1x1*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I3a12          |CKM1x2*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I3a13          |CKM1x3*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I3a21          |CKM2x1*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3a22          |CKM2x2*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3a23          |CKM2x3*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3a31          |CKM3x1*yt                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3a32          |CKM3x2*yt                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3a33          |CKM3x3*yt                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4a11          |CKM1x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I4a12          |CKM1x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4a13          |CKM1x3*yb                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4a21          |CKM2x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I4a22          |CKM2x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4a23          |CKM2x3*yb                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4a31          |CKM3x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I4a32          |CKM3x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4a33          |CKM3x3*yb                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
x1x0           |-6*lam                                                                                                         % Z.f  Z.f  Z.f  Z.f   coupling.
x2x0           |-2*lam                                                                                                         % Z.f  Z.f  W+.f W-.f  coupling.
x3x0           |-4*lam                                                                                                         % W+.f W+.f W-.f W-.f  coupling.
x4x0           |-2*lam                                                                                                         % Z.f  Z.f  H    H     coupling.
x5x0           |-2*lam                                                                                                         % W+.f W-.f H    H     coupling.
x6x0           |-6*lam                                                                                                         % H    H    H    H     coupling.
x7x0           |-2*lam*vev                                                                                                     % Z.f  Z.f  H     coupling.
x8x0           |-2*lam*vev                                                                                                     % W+.f W-.f H     coupling.
x9x0           |-6*lam*vev                                                                                                     % H    H    H     coupling.
x10x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X11  X11   coupling.
x11x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X11  X11   coupling.
x12x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X12  X12   coupling.
x13x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X12  X12   coupling.
x14x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X13  X13   coupling.
x15x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X13  X13   coupling.
x16x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X21  X21   coupling.
x17x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X21  X21   coupling.
x18x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X22  X22   coupling.
x19x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X22  X22   coupling.
x20x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X23  X23   coupling.
x21x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X23  X23   coupling.
x22x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X31  X31   coupling.
x23x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X31  X31   coupling.
x24x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X32  X32   coupling.
x25x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X32  X32   coupling.
x26x0          |-lP-6*K6*pow(vev,2)                                                                                            % H    H    X33  X33   coupling.
x27x0          |-(vev*(lP+2*K6*pow(vev,2)))                                                                                    % H    X33  X33   coupling.
x28x0          |-lR1-6*K4*pow(vev,2)                                                                                           % H    H    ~ZL11~ZL11 coupling.
x29x0          |-(vev*(lR1+2*K4*pow(vev,2)))                                                                                   % H    ~ZL11~ZL11 coupling.
x30x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X11  X11  ~ZL11~ZL11 coupling.
x31x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X12  X12  ~ZL11~ZL11 coupling.
x32x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X13  X13  ~ZL11~ZL11 coupling.
x33x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X21  X21  ~ZL11~ZL11 coupling.
x34x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X22  X22  ~ZL11~ZL11 coupling.
x35x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X23  X23  ~ZL11~ZL11 coupling.
x36x0          |-2*(2*gLP+K7*pow(vev,2))                                                                                       % X31  X31  ~ZL11~ZL11 coupling.
