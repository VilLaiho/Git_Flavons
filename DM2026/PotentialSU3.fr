(*Invariantes*)
Aph := Sum[HC[phiTilde[l,r]] phiTilde[l,r], {r, 1, 3},{l, 1, 3}];
AP := Sum[phiL[l, g] * HC[phiTilde][l, r] * phiR[r, g], {r, 1, 3}, {f, 1, 3}, {l, 1, 3}];
AR := Sum[HC[phiR[r, f]] phiR[r, f], {r, 1, 3}, {f, 1, 3}];
AL := Sum[HC[phiL[l, f]] phiL[l, f], {l, 1, 3}, {f, 1, 3}];
CLL := Sum[phiL[l, f] HC[phiL[l, f]] HC[phiL[l, f]] phiL[l, f], {l, 1, 3}, {f, 1, 3}];
CRR := Sum[phiR[r, f] HC[phiR[r, f]] HC[phiR[r, f]] phiR[r, f], {r, 1, 3}, {f, 1, 3}];
CLR := Sum[ phiL[l, f] HC[phiL[l, f]] HC[phiR[r, f]] phiR[r, f] , {r, 1, 3}, {l, 1, 3}, {f, 1, 3}];
Ldmp = -(mL AL + mR AR + mP Aph + gLR AL AR + gLL AL AL + gRR AR AR + gP1 AL Aph + gP2 AR Aph + gP3 Aph Aph + gPT AP + gP4 CLL + gP5 CRR + gP6 CLR + gP7 AL AP + gP8 AR AP + gP9 Aph AP + gP10 AL AL AL + gP11 AR AR AR + gP12 Aph Aph Aph + gP13 AL Aph AR + gP14 AL AL Aph + gP15 AR AR Aph + gP16 Aph Aph AL + gP17 Aph Aph AR + gP18 AL CLL + gP19 AL CRR + gP20 AL CLR + gP21 AR CLL + gP22 AR CRR + gP23 AR CLR + gP24 Aph CLL + gP25 Aph CRR + gP26 Aph CLR + gP27 AP^2 + gP28 AL AL AP + gP29 AL AR AP + gP30 AL Aph AP + gP31 AR AR AP + gP32 AR Aph AP + gP33 Aph Aph AP + gP34 CLL AP + gP35 CRR AP + gP36 CLR AP);
