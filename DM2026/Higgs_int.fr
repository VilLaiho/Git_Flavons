(*Lagrangiano*)
(*Estàn separados por ordenes: 4,6 (5 y 7 están en el otro potencial)*)
LHig = -(vev^2/2 + vev * H + H^2/2)*(lh1* AL + lh2* AR + lh3 Aph) - (vev^2/2 + vev * H + H^2/2)*(lh5 AL^2 + lh6 AR^2 + lh7 Aph^2 + lh8 AL AR + lh9 AL Aph + lh10 AR Aph + (vev^2/2 + vev * H + H^2/2)*(lh11*AR + lh12*AL + lh13*Aph));


